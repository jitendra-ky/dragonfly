# Copy to .env.aws and fill in the values before running ./zcommand.sh.
DJANGO_ENV=production
SECRET_KEY=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=https://your-vercel-project.vercel.app
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
BACKEND_HOSTNAME=dragonfly-backend.jitendra.xyz
ALLOWED_HOSTS=your-vercel-project.vercel.app

# These values are used by the PostgreSQL Compose service.
# Keep POSTGRES_PASSWORD URL-safe (letters and numbers) for this deployment script.
POSTGRES_USER=dragonfly
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=dragonfly
